Yes. If you want to test a tone-only architecture, you can remove the AR/ARMA stochastic filter entirely. Your model becomes

e(t)=b+\sum_{j=1}^{N_t} A_j\sin(2\pi f_jt+\phi_j).

The MATLAB identification can stay very close to your existing code: downsample → remove bias → FFT to identify frequencies → least-squares fit amplitude/phase. Then in C++, you only need to hard-code the identified parameters and evaluate the sinusoids at simulation time.

1. Minimal MATLAB tone-identification script

This is essentially your existing identification code with everything after the tone fit removed.

%% ============================================================
% SIMPLE SENSOR TONE MODEL IDENTIFICATION
%
% Model:
%
% error(t) = bias + sum_j A_j*sin(2*pi*f_j*t + phi_j)
% ============================================================
clear; clc; close all;
%% USER INPUTS
xTest = YOUR_DATA(:);
Fs_in = 1000;             % Original sample rate [Hz]
Fs    = 80;               % Model sample rate [Hz]
baseline = 0;
% Original-data regime indices
ts = [1      30001  60001];
te = [30000  60000  90000];
% Number of tones to retain per regime
nTones = [4 3 4];
%% DOWNSAMPLE
ratio = Fs_in/Fs;
keepIdx = unique(round(1:ratio:length(xTest)));
x_ds = xTest(keepIdx);
%% MAP REGIMES
numRegimes = length(ts);
ts_ds = zeros(size(ts));
te_ds = zeros(size(te));
for i = 1:numRegimes
    ts_ds(i) = find(keepIdx >= ts(i),1,'first');
    te_ds(i) = find(keepIdx <= te(i),1,'last');
end
%% IDENTIFY TONES
toneModel = struct;
for i = 1:numRegimes
    xr = x_ds(ts_ds(i):te_ds(i));
    L = length(xr);
    t = (0:L-1)'/Fs;
    % ---------------------------------------------------------
    % 1. Bias
    % ---------------------------------------------------------
    bias = mean(xr) - baseline;
    x0 = xr - mean(xr);
    % ---------------------------------------------------------
    % 2. FFT
    % ---------------------------------------------------------
    Y = fft(x0);
    P = abs(Y/L);
    P = P(1:floor(L/2)+1);
    if rem(L,2) == 0
        P(2:end-1) = 2*P(2:end-1);
    else
        P(2:end) = 2*P(2:end);
    end
    f_fft = (0:floor(L/2))' * Fs/L;
    % ---------------------------------------------------------
    % 3. Find dominant tone frequencies
    % ---------------------------------------------------------
    Psearch = P;
    Psearch(1) = 0;       % Do not select DC
    [~,peakLoc] = findpeaks( ...
        Psearch, ...
        'SortStr','descend');
    n = min(nTones(i),length(peakLoc));
    peakLoc = peakLoc(1:n);
    toneFreq = sort(f_fft(peakLoc));
    % ---------------------------------------------------------
    % 4. Fit amplitude + phase
    % ---------------------------------------------------------
    H = zeros(L,2*n);
    for j = 1:n
        H(:,2*j-1) = sin(2*pi*toneFreq(j)*t);
        H(:,2*j)   = cos(2*pi*toneFreq(j)*t);
    end
    beta = H\x0;
    fittedTone = H*beta;
    toneAmp   = zeros(n,1);
    tonePhase = zeros(n,1);
    for j = 1:n
        a = beta(2*j-1);
        b = beta(2*j);
        toneAmp(j)   = hypot(a,b);
        tonePhase(j) = atan2(b,a);
    end
    % ---------------------------------------------------------
    % 5. Store model
    % ---------------------------------------------------------
    toneModel(i).bias      = bias;
    toneModel(i).toneFreq  = toneFreq;
    toneModel(i).toneAmp   = toneAmp;
    toneModel(i).tonePhase = tonePhase;
    % ---------------------------------------------------------
    % Display parameters for C++ implementation
    % ---------------------------------------------------------
    fprintf('\n============================\n')
    fprintf('REGIME %d\n',i)
    fprintf('============================\n')
    fprintf('Bias = %.12g\n\n',bias)
    disp(table( ...
        toneFreq, ...
        toneAmp, ...
        tonePhase, ...
        'VariableNames', ...
        {'Frequency_Hz','Amplitude','Phase_rad'}))
    % ---------------------------------------------------------
    % Quick validation
    % ---------------------------------------------------------
    reconstructed = bias + fittedTone;
    figure
    plot(t,xr,'LineWidth',2)
    hold on
    plot(t,reconstructed,'LineWidth',2)
    grid on
    xlabel('Time [s]')
    ylabel('Sensor Output')
    legend('Test','Tone Model')
    title(sprintf('Regime %d - Tone Model',i))
end

That gives you exactly the parameters needed by the simulation:

bias
toneFreq(1)
toneAmp(1)
tonePhase(1)
toneFreq(2)
toneAmp(2)
tonePhase(2)
...

No AR coefficients, no filter history, no Gaussian RNG, and no CSV is inherently necessary.

